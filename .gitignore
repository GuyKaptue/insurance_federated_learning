# ============================================================
# Reports and Outputs (Keep structure, ignore generated content)
# ============================================================
# Keep directory structure but ignore generated files
outputs/reports/*.html
outputs/reports/*.json
outputs/reports/*.md
!outputs/reports/*_template.html
!outputs/reports/*_template.md
!outputs/reports/.gitkeep

# Generated plots
outputs/reports/**/plots/
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf

# Keep plot directory structure
!outputs/reports/**/plots/.gitkeep

# ============================================================
# Data directories (Keep structure visible)
# ============================================================
# Ignore generated data files but keep directories visible
data/processed/**/*.parquet
data/processed/**/*.npy
data/processed/**/*.npz
data/processed/**/*.csv
data/processed/**/*.json
!data/processed/**/metadata.json
!data/processed/**/dataset_info.json

data/synthetic/**/*.parquet
data/synthetic/**/*.npy
data/synthetic/**/*.npz
data/synthetic/**/*.csv

data/raw/**/*.parquet
data/raw/**/*.npy
data/raw/**/*.npz
data/raw/**/*.csv

data/external/**/*.parquet
data/external/**/*.npy
data/external/**/*.npz
data/external/**/*.csv

# But keep all directory structures and metadata files
!data/processed/.gitkeep
!data/processed/**/.gitkeep
!data/processed/**/metadata.json
!data/processed/**/dataset_info.json
!data/processed/**/info.json
!data/raw/.gitkeep
!data/synthetic/.gitkeep
!data/external/.gitkeep

